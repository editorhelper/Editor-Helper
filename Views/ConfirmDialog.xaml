<Window x:Class="EditorHelper.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение"
        Width="440"
        SizeToContent="Height"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="{StaticResource BgElevated}"
            BorderBrush="{StaticResource GlassBorderBright}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="26,24,26,22"
            Margin="24">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Margin="0,10,0,0"/>

            <TextBlock x:Name="HintText"
                       FontSize="11.5"
                       Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="CancelButton"
                        Content="Отмена"
                        Style="{StaticResource GlassButtonSmall}"
                        Padding="18,8"
                        Margin="0,0,10,0"
                        IsCancel="True"/>
                <Button x:Name="ConfirmButton"
                        Content="Подтвердить"
                        Style="{StaticResource PrimaryButton}"
                        Padding="18,8"
                        IsDefault="True"
                        Click="ConfirmButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
