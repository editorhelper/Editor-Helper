<Window x:Class="EditorHelper.Setup.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EditorHelper.Setup.Ui"
        Title="Editor Helper — удаление"
        Width="520" Height="340"
        MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgPrimary}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:SpaceBackground x:Name="Space" Grid.RowSpan="2"/>

        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,0,1"
                Padding="16,9"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Border Width="26" Height="26" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <ui:AvatarImage Source="pack://application:,,,/Resources/avatar.png"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="EDITOR HELPER" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="удаление" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="1,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,22">
            <!-- Экран подтверждения -->
            <StackPanel x:Name="ConfirmPanel" VerticalAlignment="Center">
                <TextBlock Text="Удалить Editor Helper?" FontSize="24" FontWeight="Light" Foreground="{StaticResource TextPrimary}"/>

                <TextBlock x:Name="FolderText" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap"/>

                <Border Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Будет удалено:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="файлы приложения, ярлыки, запись в списке программ" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                        <TextBlock Text="Не будет удалено: настройки, избранное, аккаунт (%LOCALAPPDATA%\EditorHelper)" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Content="Удалить" Style="{StaticResource PrimaryButton}" MinWidth="140" Click="UninstallButton_Click"/>
                    <Button Content="Отмена" Style="{StaticResource GlassButton}" Margin="12,0,0,0" Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Экран прогресса -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Удаление Editor Helper" FontSize="22" FontWeight="Light" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ProgressDetail" Text="Удаление файлов…" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <Grid Margin="0,24,0,0">
                    <Border Height="4" Background="{StaticResource GlassBorder}" CornerRadius="2" ClipToBounds="True">
                        <Border x:Name="ProgressFill" Width="0" Background="{StaticResource AccentGradient}" CornerRadius="2" HorizontalAlignment="Left"/>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Экран завершения -->
            <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="88" Height="88" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Ellipse Width="82" Height="82" Stroke="{StaticResource GlassBorder}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                    <Path Data="M 24,44 L 36,56 L 58,32"
                          Stroke="#F2F2F2" StrokeThickness="4.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None"/>
                </Grid>
                <TextBlock Text="Editor Helper удалён" FontSize="22" FontWeight="Light" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DoneNote" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Content="Закрыть" Style="{StaticResource PrimaryButton}" MinWidth="140" HorizontalAlignment="Center" Margin="0,20,0,0" Click="CloseButton_Click"/>
            </StackPanel>

            <!-- Ошибка -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Не удалось удалить" FontSize="20" FontWeight="Light" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Повторить" Style="{StaticResource GlassButton}" Click="UninstallButton_Click"/>
                    <Button Content="Закрыть" Style="{StaticResource GlassButton}" Margin="12,0,0,0" Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
