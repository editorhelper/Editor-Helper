<Window x:Class="EditorHelper.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступно обновление"
        Width="480"
        SizeToContent="Height"
        MaxHeight="560"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="{StaticResource BgElevated}"
            BorderBrush="{StaticResource GlassBorderBright}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="26,24,26,22"
            Margin="24">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Доступно обновление!"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Вышла новая версия Editor Helper."
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Текущая версия: "
                               FontSize="12.5"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="CurrentVersionText"
                               FontSize="12.5"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                    <TextBlock Text="Новая версия: "
                               FontSize="12.5"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="NewVersionText"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource GlassBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12,14,12"
                    Margin="0,14,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                    <StackPanel>
                        <TextBlock Text="Что нового"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="NotesText"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3"
                        x:Name="ProgressPanel"
                        Visibility="Collapsed"
                        Margin="0,14,0,0">
                <TextBlock x:Name="ProgressText"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,0,0,8"/>
                <Border Height="4"
                        Background="{StaticResource GlassBorder}"
                        CornerRadius="2"
                        ClipToBounds="True">
                    <Border x:Name="ProgressFill"
                            Width="0"
                            Background="{StaticResource AccentGradient}"
                            CornerRadius="2"
                            HorizontalAlignment="Left"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="LaterButton"
                        Content="Позже"
                        Style="{StaticResource GlassButtonSmall}"
                        Padding="18,8"
                        Margin="0,0,10,0"
                        Click="LaterButton_Click"/>
                <Button x:Name="UpdateButton"
                        Content="Обновить сейчас"
                        Style="{StaticResource PrimaryButton}"
                        Padding="18,8"
                        Click="UpdateButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
