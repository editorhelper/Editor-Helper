<Application x:Class="EditorHelper.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!-- Дизайн-система Premium Cosmic: значения скопированы из основного
             приложения (Resources/Styles.xaml + Ui/Palette.cs), чтобы
             установщик выглядел частью Editor Helper, а не отдельной
             программой -->
        <Color x:Key="ColorBgPrimary">#000000</Color>
        <Color x:Key="ColorBgSecondary">#060606</Color>
        <Color x:Key="ColorBgElevated">#121212</Color>
        <Color x:Key="ColorTextPrimary">#F2F2F2</Color>
        <Color x:Key="ColorTextSecondary">#A6A6A6</Color>
        <Color x:Key="ColorTextMuted">#666666</Color>

        <SolidColorBrush x:Key="BgPrimary" Color="{StaticResource ColorBgPrimary}"/>
        <SolidColorBrush x:Key="BgSecondary" Color="{StaticResource ColorBgSecondary}"/>
        <SolidColorBrush x:Key="BgElevated" Color="{StaticResource ColorBgElevated}"/>

        <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{StaticResource ColorTextMuted}"/>

        <!-- Стекло -->
        <SolidColorBrush x:Key="Glass" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="GlassHover" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="GlassBorderBright" Color="#3AFFFFFF"/>
        <SolidColorBrush x:Key="CardSurface" Color="#C40C0C0C"/>
        <SolidColorBrush x:Key="CardBorderRest" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="Divider" Color="#14FFFFFF"/>

        <!-- Акцент: используется шаг-индикатором и точками этапа -->
        <SolidColorBrush x:Key="Accent" Color="#FFFFFF"/>

        <!-- Градиент главного действия: белый -> светло-серый -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#CFCFCF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#E6E6E6" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================================
             Кнопки — те же шаблоны, что в приложении
             ============================================================ -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="#05070E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="PBBase" Background="{StaticResource AccentGradient}" CornerRadius="10"/>
                            <Border x:Name="PBHover" Background="{StaticResource AccentGradientHover}" CornerRadius="10" Opacity="0"/>
                            <Border x:Name="PBRing" BorderBrush="#8CFFFFFF" BorderThickness="1" CornerRadius="13" Margin="-3" Opacity="0"/>
                            <Border Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PBHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation Storyboard.TargetName="PBHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PBBase" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="PBHover" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PBBase" Property="Background" Value="{StaticResource Glass}"/>
                                <Setter TargetName="PBHover" Property="Opacity" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PBRing" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GBBase" Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="10"/>
                            <Border x:Name="GBHover" Background="#26FFFFFF" BorderBrush="#E6FFFFFF" BorderThickness="1" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                            <Border Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GBHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation Storyboard.TargetName="GBHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GBHover" Property="Background" Value="#42FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки управления окном: монохром, закрытие без красного -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#42FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле ввода пути -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Glass}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TB" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TB" Property="BorderBrush" Value="{StaticResource GlassBorderBright}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TB" Property="BorderBrush" Value="{StaticResource GlassBorderBright}"/>
                                <Setter TargetName="TB" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Переключатель (custom toggle) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="38" Height="20" CornerRadius="10" Background="{StaticResource Glass}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7" Background="{StaticResource TextMuted}" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbShift"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource GlassHover}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GlassBorderBright}"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GlassBorderBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
