<UserControl x:Class="EditorHelper.Views.AdminEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок раздела -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource GlassButtonSmall}"
                    Padding="12,9"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    Click="BackButton_Click"
                    ToolTip="Назад к списку карточек"/>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeaderTitle"
                           Text="Новая карточка"
                           FontSize="26"
                           FontWeight="Light"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="HeaderSubtitle"
                           Text="Поля со звёздочкой обязательны"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Форма и предпросмотр -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,24,0">
                <StackPanel x:Name="FormPanel" Margin="0,0,6,16"/>
            </ScrollViewer>

            <!-- Предпросмотр: ровно то, что увидят пользователи -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Предпросмотр"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Так карточка выглядит в каталоге приложения"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <ContentControl x:Name="PreviewHost"/>

                    <TextBlock x:Name="PreviewNote"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Действия -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0"
                Padding="0,16,0,0"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FooterStatus"
                           Grid.Column="0"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap"
                           MaxWidth="560"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="Отмена"
                        Style="{StaticResource GlassButton}"
                        Padding="20,9"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Content="Создать карточку"
                        Style="{StaticResource PrimaryButton}"
                        Padding="24,9"
                        Click="SaveButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
