<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         PREMIUM COSMIC — монохром: глубокий чёрный космос, белые
         акценты и градации серого, стеклянные поверхности
         ============================================================ -->

    <!-- Палитра поверхностей -->
    <Color x:Key="ColorBgPrimary">#000000</Color>
    <Color x:Key="ColorBgSecondary">#060606</Color>
    <Color x:Key="ColorBgTertiary">#0B0B0B</Color>
    <Color x:Key="ColorBgElevated">#121212</Color>
    <Color x:Key="ColorBgPanel">#181818</Color>

    <!-- Акценты -->
    <Color x:Key="ColorAccent">#FFFFFF</Color>
    <Color x:Key="ColorAccentHover">#D6D6D6</Color>
    <Color x:Key="ColorSecondary">#C8C8C8</Color>
    <Color x:Key="ColorSuccess">#E6E6E6</Color>
    <Color x:Key="ColorDanger">#FFFFFF</Color>

    <!-- Текст: светлый, но не ослепительно белый -->
    <Color x:Key="ColorTextPrimary">#F2F2F2</Color>
    <Color x:Key="ColorTextSecondary">#A6A6A6</Color>
    <Color x:Key="ColorTextMuted">#666666</Color>

    <!-- Кисти поверхностей -->
    <SolidColorBrush x:Key="BgPrimary" Color="{StaticResource ColorBgPrimary}"/>
    <SolidColorBrush x:Key="BgSecondary" Color="{StaticResource ColorBgSecondary}"/>
    <SolidColorBrush x:Key="BgTertiary" Color="{StaticResource ColorBgTertiary}"/>
    <SolidColorBrush x:Key="BgElevated" Color="{StaticResource ColorBgElevated}"/>
    <SolidColorBrush x:Key="BgPanel" Color="{StaticResource ColorBgPanel}"/>

    <!-- Кисти текста -->
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource ColorTextMuted}"/>

    <!-- Кисти акцентов -->
    <SolidColorBrush x:Key="Accent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="Secondary" Color="{StaticResource ColorSecondary}"/>
    <SolidColorBrush x:Key="Success" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource ColorDanger}"/>

    <!-- Стекло -->
    <SolidColorBrush x:Key="Glass" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="GlassHover" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="GlassPressed" Color="#3AFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorder" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBright" Color="#3AFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderHover" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Divider" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CardSurface" Color="#C40C0C0C"/>
    <SolidColorBrush x:Key="CardBorderRest" Color="#3DFFFFFF"/>

    <!-- Градиенты для главных действий и подсветки -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ColorAccent}" Offset="0"/>
        <GradientStop Color="{StaticResource ColorSecondary}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ColorAccentHover}" Offset="0"/>
        <GradientStop Color="#B0B0B0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Свечения и тени -->
    <DropShadowEffect x:Key="GlowAccent" Color="White" BlurRadius="26" ShadowDepth="0" Opacity="0.34"/>
    <DropShadowEffect x:Key="GlowSoft" Color="White" BlurRadius="20" ShadowDepth="0" Opacity="0.20"/>
    <DropShadowEffect x:Key="CardShadow" Color="Black" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.55"/>
    <DropShadowEffect x:Key="CardShadowLifted" Color="Black" BlurRadius="32" ShadowDepth="14" Direction="270" Opacity="0.68"/>

    <!-- Типографика -->
    <FontFamily x:Key="FontFamily">Segoe UI, Arial, sans-serif</FontFamily>

    <!-- Отступы -->
    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingSM">8</Thickness>
    <Thickness x:Key="SpacingMD">16</Thickness>
    <Thickness x:Key="SpacingLG">24</Thickness>
    <Thickness x:Key="SpacingXL">32</Thickness>

    <!-- Скругления -->
    <CornerRadius x:Key="RadiusSM">6</CornerRadius>
    <CornerRadius x:Key="RadiusMD">10</CornerRadius>
    <CornerRadius x:Key="RadiusLG">14</CornerRadius>
    <CornerRadius x:Key="RadiusXL">18</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ============================================================
         Навигация: стеклянная подложка, голубой индикатор активного раздела
         ============================================================ -->

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Индикатор активного раздела: тонкая белая полоса слева -->
                        <Border x:Name="NavIndicator"
                                Width="3"
                                HorizontalAlignment="Left"
                                CornerRadius="0,3,3,0"
                                Background="Transparent"
                                Margin="0,6"/>

                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Effect="{TemplateBinding Effect}"
                                Padding="{TemplateBinding Padding}"
                                Margin="3,0,0,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="#26FFFFFF"/>
                            <Setter TargetName="NavBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <!-- Недоступный раздел («скоро»): приглушён и без указателя-руки -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="NavBorder" Property="Background" Value="Transparent"/>
                        </Trigger>
                        <!-- Активный пункт ведётся из код-бихайнда (Tag хранит имя страницы) -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="14,18,14,8"/>
    </Style>

    <Style x:Key="NavSeparator" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Divider}"/>
        <Setter Property="Margin" Value="12,10"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <!-- Бейдж «Soon» для разделов, которые ещё не открыты -->
    <Style x:Key="SoonBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Glass}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>

    <Style x:Key="SoonBadgeText" TargetType="TextBlock">
        <Setter Property="Text" Value="Soon"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- Цвет задаётся на самом элементе: кнопка отключена, и её приглушённый
             Foreground наследовался бы в текст, делая «Soon» нечитаемым -->
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <!-- ============================================================
         Кнопки управления окном — монохромные, закрытие без красного
         ============================================================ -->

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CaptionBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaptionBorder" Property="Background" Value="#2EFFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CaptionBorder" Property="Background" Value="#42FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Кнопки контента: основные с градиентом, второстепенные стеклянные
         ============================================================ -->

    <!--
        Обводка кнопок: непрерывная граница одного Border, цвет плавно анимируется
        ColorAnimation (без From — стартует с текущего значения, поэтому при быстром
        наведении/уходе нет скачков). DropShadowEffect намеренно НЕ используется:
        эффект обрезается родительскими контейнерами и переводит поддерево
        в программный рендер, из-за чего граница «плавает» и теряет чёткость.
        Кисти заданы inline в шаблоне — у каждой кнопки свой экземпляр, поэтому
        анимация цвета одной кнопки не задевает остальные.
    -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="Foreground" Value="#05070E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="22,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="PBBase"
                                Background="{StaticResource AccentGradient}"
                                CornerRadius="10"/>
                        <Border x:Name="PBHover"
                                Background="{StaticResource AccentGradientHover}"
                                CornerRadius="10"
                                Opacity="0"/>
                        <Border x:Name="PBFocusRing"
                                BorderBrush="#8CFFFFFF"
                                BorderThickness="1"
                                CornerRadius="13"
                                Margin="-3"
                                Opacity="0"/>
                        <Border x:Name="PB"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PBHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="PBHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PBBase" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="PBHover" Property="Opacity" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PBBase" Property="Background" Value="{StaticResource Glass}"/>
                            <Setter TargetName="PBHover" Property="Opacity" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PBFocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Glass}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="22,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Базовая граница и фон в покое -->
                        <Border x:Name="GBBase"
                                Background="{StaticResource Glass}"
                                BorderBrush="{StaticResource GlassBorder}"
                                BorderThickness="1"
                                CornerRadius="10"/>
                        <!-- Hover-слой: та же геометрия, накладывается точно поверх базы,
                             поэтому обводка непрерывна по всему периметру. Анимация — только
                             Opacity слоя на экземпляр (не цвет общей кисти). -->
                        <Border x:Name="GBHover"
                                Background="#26FFFFFF"
                                BorderBrush="#E6FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <!-- Pressed-слой поверх hover: виден, пока кнопка нажата -->
                        <Border x:Name="GBPressed"
                                Background="#3AFFFFFF"
                                BorderBrush="#FFFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <!-- Кольцо фокуса рисуется снаружи формы -->
                        <Border x:Name="GBFocusRing"
                                BorderBrush="#8CFFFFFF"
                                BorderThickness="1"
                                CornerRadius="13"
                                Margin="-3"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <!-- Прозрачный фон держит hit-test по всей площади кнопки,
                             поэтому IsMouseOver не срывается на тексте/иконке -->
                        <Border x:Name="GB"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GBHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="GBHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GBPressed" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Setter TargetName="GBBase" Property="BorderBrush" Value="{StaticResource Divider}"/>
                            <Setter TargetName="GBBase" Property="Background" Value="Transparent"/>
                            <Setter TargetName="GBHover" Property="Opacity" Value="0"/>
                            <Setter TargetName="GBPressed" Property="Opacity" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="GBFocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Небольшая стеклянная кнопка для карточек и плиток -->
    <Style x:Key="GlassButtonSmall" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Контурная кнопка карточки авторизации -->
    <Style x:Key="AuthOutlineButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ============================================================
         Поля ввода и переключатели
         ============================================================ -->

    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="CheckBorder"
                                Width="18" Height="18"
                                Background="{StaticResource Glass}"
                                BorderBrush="{StaticResource GlassBorder}"
                                BorderThickness="1"
                                CornerRadius="5"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckMark"
                                  Data="M 3,8 L 6.5,11.5 L 13,4.5"
                                  Stroke="#05070E"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentGradient}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#59FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="RadioBorder"
                                Width="18" Height="18"
                                Background="{StaticResource Glass}"
                                BorderBrush="{StaticResource GlassBorder}"
                                BorderThickness="1"
                                CornerRadius="999"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="RadioDot"
                                     Width="8" Height="8"
                                     Fill="Transparent"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="RadioDot" Property="Fill" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#59FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Выпадающие списки: стеклянное поле и тёмный список
         ============================================================ -->

    <Style x:Key="GlassComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource GlassHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource GlassPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource Glass}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource GlassComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ComboToggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ComboBorder"
                                            Background="{StaticResource Glass}"
                                            BorderBrush="{StaticResource GlassBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Path Data="M0,0 L4,4 L8,0"
                                              Stroke="{StaticResource TextSecondary}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,1,13,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource GlassBorderBright}"/>
                                            <Setter TargetName="ComboBorder" Property="Background" Value="#14FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ComboContent"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource BgElevated}"
                                    BorderBrush="{StaticResource GlassBorderBright}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,5,0,0"
                                    Padding="0,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Effect="{StaticResource CardShadow}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Скроллбары: тонкие, холодные
         ============================================================ -->

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Background="#28FFFFFF"
                                                    CornerRadius="999"
                                                    Margin="2,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#3AFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         Индикатор загрузки
         ============================================================ -->

    <Style x:Key="LoadingSpinner" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="BorderThickness" Value="2.5"/>
        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>

    <!-- ============================================================
         Подсказки (ToolTip)
         ============================================================ -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BgElevated}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBright}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource CardShadow}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
