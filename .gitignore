# Сборка
bin/
obj/
dist/
TestOutput/

# Релизные артефакты: воспроизводятся из кода, бинарники в git не нужны.
# Путь с ** — потому что репозиторий кладёт клиент в подпапку "Editor Helper Client"
**/Release/payload/
**/Release/publish/
**/Release/output/
**/Release/obfuscated/
**/Release/_verify/
*.exe.sha256

# Сгенерированная иконка: создаётся сборкой из avatar.png
**/Resources/app.ico

# Пользовательские данные клиента (появляются рядом с exe при портативном запуске)
settings.json
favorites.json
downloads.json

# Секреты устройства и сессии (DPAPI, привязаны к машине — в git нельзя)
device.key
session.bin

# Обновления, скачанные приложением
updates/

# IDE
.vs/
.idea/
*.user
.vscode/

# ОС
Thumbs.db
.DS_Store

# Сборочные артефакты кастомного установщика
Release/setup/
Release/build.log
