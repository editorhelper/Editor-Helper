# Настройки сервера Editor Helper.
# Скопируйте в server-data/secrets.json (рядом с данными, не в git)
# или задайте как переменные окружения. Переменные окружения главнее файла.
#
# Секретов здесь нет и быть не должно — файл-пример можно коммитить.

# Токен бота от @BotFather. Хранится ТОЛЬКО на сервере, клиенту не передаётся.
TELEGRAM_BOT_TOKEN=

# Канал с архивами: @username публичного канала или числовой id приватного
# (приватный id выглядит как -1001234567890). Бот должен быть администратором канала.
TELEGRAM_CHANNEL_ID=

# Базовый адрес Bot API. По умолчанию api.telegram.org; можно указать свой
# локальный Bot API-сервер (Telegram это поддерживает) — снимает лимит 20 МБ.
TELEGRAM_API_BASE=https://api.telegram.org

# Как получать обновления. Локально без публичного HTTPS — только long polling (true).
TELEGRAM_USE_POLLING=true

# Таймаут long polling в секундах (Telegram ждёт до 50).
TELEGRAM_POLL_TIMEOUT=25

# Токен админки. Если пусто — сервер сгенерирует сам и положит в
# server-data/admin-token.txt. Задайте свой для постоянного значения.
EDITORHELPER_ADMIN_TOKEN=

# Адрес и порт, которые сервер слушает. Локально — 127.0.0.1, наружу не видно.
EDITORHELPER_PORT=5080

# Базовый адрес, который подставляется в ссылки для клиента. Пусто — взять из
# запроса. На VPS укажите публичный адрес, например https://api.example.com
EDITORHELPER_PUBLIC_URL=

# Папка данных сервера: каталог, обнаруженные документы, файлы, секреты.
# По умолчанию server-data рядом с исполняемым файлом.
EDITORHELPER_DATA_DIR=
