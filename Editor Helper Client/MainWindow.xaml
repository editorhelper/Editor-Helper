<Window x:Class="EditorHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:EditorHelper.Ui"
        mc:Ignorable="d"
        Title="Editor Helper"
        Height="860"
        Width="1400"
        MinHeight="660"
        MinWidth="1080"
        Background="{StaticResource BgPrimary}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseMove="Window_MouseMove"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Безрамочное окно: перетаскивание за верхнюю панель, resize по краям -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Живой космический фон: частицы, туманности, параллакс -->
        <ui:SpaceBackground x:Name="SpaceCanvas" Grid.RowSpan="2"/>

        <!-- ======================= Top Bar ======================= -->
        <Border x:Name="TopBar"
                Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип: аватарка + название -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0,24,0">
                    <!-- Жёсткой круглой рамки нет: маска растворяет край сама,
                         а контур поверх него вернул бы «вырезанный кружок».
                         Свечение живёт отдельно от маски и остаётся деликатным. -->
                    <Border x:Name="LogoFrame"
                            Width="34" Height="34"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect x:Name="LogoGlow" Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <ui:AvatarImage Source="pack://application:,,,/Resources/avatar.png"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="EDITOR HELPER"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="creative workspace"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="1,-1,0,0"/>
                    </StackPanel>
                    <Border x:Name="SourceBadgeBorder"
                            Background="{StaticResource Glass}"
                            BorderBrush="{StaticResource GlassBorder}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Margin="16,0,0,0"
                            Padding="10,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="SourceBadgeText"
                                   Text="Local Development"
                                   FontSize="10.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                </StackPanel>

                <!-- Поиск -->
                <Border x:Name="SearchFrame"
                        Grid.Column="1"
                        Background="{StaticResource Glass}"
                        BorderBrush="{StaticResource GlassBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Style="{StaticResource GlassTextBox}"
                                 Text="Search tools, plugins, presets..."
                                 Foreground="{StaticResource TextMuted}"
                                 Width="380"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"/>
                        <Button x:Name="SearchClearButton"
                                Grid.Column="2"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="11"
                                Width="26" Height="26"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                Foreground="{StaticResource TextMuted}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="SearchClear_Click"
                                ToolTip="Clear search"/>
                    </Grid>
                </Border>

                <!-- Управление окном -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Button x:Name="AccountButton" Content="Sign in" Style="{StaticResource GlassButtonSmall}" Click="AccountButton_Click" Margin="0,0,12,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="11.5"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                            Content="&#xE921;" Click="MinimizeButton_Click"
                            ToolTip="Minimize"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                            Content="&#xE922;" Click="MaximizeButton_Click"
                            ToolTip="Maximize"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}"
                            Content="&#xE8BB;" Click="CloseButton_Click"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= Main Layout ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource Divider}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SidebarPanel" Margin="10,14,10,14">

                        <Button Style="{StaticResource NavButton}" Tag="Home" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Home" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Style="{StaticResource NavSeparator}"/>
                        <TextBlock Text="LIBRARY" Style="{StaticResource NavHeader}"/>

                        <Button Style="{StaticResource NavButton}" Tag="Scripts" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Scripts" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Tag="Plugins" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Plugins" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Разделы «скоро»: видны в навигации, но не активны -->
                        <Button Style="{StaticResource NavButton}" Tag="Presets" IsEnabled="False"
                                ToolTip="Coming soon" ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Presets" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource SoonBadge}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SoonBadgeText}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Tag="Overlays" IsEnabled="False"
                                ToolTip="Coming soon" ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Overlays" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource SoonBadge}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SoonBadgeText}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Tag="Sounds" IsEnabled="False"
                                ToolTip="Coming soon" ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Sound Library" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource SoonBadge}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource SoonBadgeText}"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Separator Style="{StaticResource NavSeparator}"/>
                        <TextBlock Text="WORKSPACE" Style="{StaticResource NavHeader}"/>

                        <Button Style="{StaticResource NavButton}" Tag="Library" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="My Library" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Tag="Downloads" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Downloads" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AdminNavButton" Style="{StaticResource NavButton}" Tag="Admin"
                                Click="NavButton_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE912;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Admin Panel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Tag="Settings" Click="NavButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content -->
            <ScrollViewer x:Name="ContentScroll"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="40,32,40,40">
                <StackPanel x:Name="ContentArea"/>
            </ScrollViewer>

            <!-- Форма карточки админки: отдельный хост, потому что ей нужна
                 ограниченная высота (свой скролл и закреплённая панель действий),
                 а ContentArea живёт в ScrollViewer с бесконечной высотой -->
            <Grid x:Name="AdminEditorHost"
                  Grid.Column="1"
                  Margin="40,24,40,0"
                  Visibility="Collapsed"/>

            <!-- Страница ресурса: открывается на месте каталога, ей тоже нужны
                 свой скролл и закреплённая панель действий -->
            <Grid x:Name="ResourceDetailHost"
                  Grid.Column="1"
                  Margin="40,24,40,0"
                  Visibility="Collapsed"/>
        </Grid>

        <!-- Оверлей авторизации: затемнение поверх интерфейса, космический фон под ним -->
        <Grid x:Name="AuthOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              MouseDown="AuthOverlay_MouseDown">
            <Grid.Background>
                <SolidColorBrush x:Name="AuthDimBrush" Color="#B4000000"/>
            </Grid.Background>
            <Grid x:Name="AuthCard"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="400"
                  Margin="32,48,32,48"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AuthCardScale"/>
                        <TranslateTransform x:Name="AuthCardLift"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Style>
                </Grid.Style>
                <!-- Поверхность — ровно та же, что у карточек каталога: CardSurface
                     поверх космического фона, тонкая граница, радиус 14 -->
                <Border x:Name="AuthCardFrame"
                        Background="{StaticResource CardSurface}"
                        BorderBrush="{StaticResource CardBorderRest}"
                        BorderThickness="1"
                        CornerRadius="14"
                        MouseLeftButtonDown="AuthCard_MouseLeftButtonDown">
                    <Grid>
                        <Button x:Name="AuthCloseButton"
                                Style="{StaticResource CaptionButton}"
                                Content="&#xE8BB;"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,8,8,0"
                                Panel.ZIndex="2"
                                Click="AuthCloseButton_Click"
                                ToolTip="Close sign-in"/>

                        <StackPanel x:Name="AuthPanel" Margin="32,26,32,24">

                            <!-- Аватар в том же оформлении, что логотип верхней панели:
                                 мягкое белое свечение за изображением, без движения -->
                            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                <Border x:Name="AuthAvatarGlow"
                                        Background="#FFFFFF"
                                        CornerRadius="32"
                                        Opacity="0.18"
                                        IsHitTestVisible="False"
                                        Effect="{StaticResource GlowSoft}"/>
                                <Border Background="{StaticResource BgElevated}"
                                        CornerRadius="32"
                                        BorderBrush="{StaticResource GlassBorderBright}"
                                        BorderThickness="1"
                                        Margin="4">
                                    <ui:AvatarImage Source="pack://application:,,,/Resources/avatar.png"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="EDITOR HELPER"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="Вход в аккаунт"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,0"/>
                            <TextBlock Text="Авторизуйтесь через Telegram, чтобы продолжить работу."
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       LineHeight="17"
                                       Margin="0,6,0,0"/>

                            <Button x:Name="AuthTelegramButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="44"
                                    FontSize="13"
                                    Margin="0,20,0,0"
                                    Click="AuthTelegramButton_Click"
                                    MouseEnter="AuthTelegramButton_MouseEnter"
                                    MouseLeave="AuthTelegramButton_MouseLeave"
                                    PreviewMouseLeftButtonDown="AuthTelegramButton_PreviewDown"
                                    PreviewMouseLeftButtonUp="AuthTelegramButton_PreviewUp">
                                <Button.RenderTransform>
                                    <TranslateTransform x:Name="AuthButtonLift" Y="0"/>
                                </Button.RenderTransform>
                                <Grid>
                                    <StackPanel x:Name="AuthButtonIdleContent" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Width="16" Height="16"
                                              Stretch="Uniform"
                                              Fill="#05070E"
                                              VerticalAlignment="Center"
                                              Data="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                                        <TextBlock Text="Продолжить через Telegram"
                                                   VerticalAlignment="Center"
                                                   Margin="9,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="AuthButtonBusyContent" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <Grid Width="15" Height="15" VerticalAlignment="Center">
                                            <Path x:Name="AuthButtonSpinner"
                                                  Data="M7.5,1.1 A6.4,6.4 0 1 1 1.1,7.5"
                                                  Stroke="#05070E"
                                                  StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stretch="None"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="AuthButtonSpin" Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                        <TextBlock x:Name="AuthButtonBusyText"
                                                   Text="Открываем Telegram…"
                                                   VerticalAlignment="Center"
                                                   Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Состояние авторизации: иконка этапа + название + подсказка -->
                            <Border Background="{StaticResource Glass}"
                                    BorderBrush="{StaticResource GlassBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,11"
                                    Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="AuthStateIconHost" Width="26" Height="26" VerticalAlignment="Top">
                                        <Ellipse Fill="#12FFFFFF" Stroke="{StaticResource GlassBorder}" StrokeThickness="1"/>
                                        <TextBlock x:Name="AuthStateGlyph"
                                                   Text="&#xE77B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Path x:Name="AuthStateSpinner"
                                              Width="13" Height="13"
                                              Data="M6.5,0.9 A5.6,5.6 0 1 1 0.9,6.5"
                                              Stroke="#F2F2F2"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="None"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="AuthStateSpin" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="AuthStateCheck"
                                              Width="14" Height="14"
                                              Data="M 3,7.2 L 5.8,10 L 11,4.4"
                                              Stroke="#F2F2F2"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="None"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                                        <Path x:Name="AuthStateError"
                                              Width="14" Height="14"
                                              Data="M 4.4,4.4 L 9.6,9.6 M 9.6,4.4 L 4.4,9.6"
                                              Stroke="#F2F2F2"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="None"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                    <StackPanel x:Name="AuthStatusTextHost" Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AuthStatusTitle"
                                                   Text="Ожидание авторизации"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock x:Name="AuthStatusHint"
                                                   Text="Нажмите кнопку, чтобы начать вход через Telegram."
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11"
                                                   LineHeight="16"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="AuthCancelButton"
                                    Content="Отменить вход"
                                    Style="{StaticResource AuthOutlineButton}"
                                    IsEnabled="False"
                                    HorizontalAlignment="Center"
                                    Padding="16,6"
                                    MinHeight="32"
                                    Margin="0,12,0,0"
                                    Click="AuthCancelButton_Click"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Безопасный вход через Telegram — пароль не требуется."
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Уведомления: всплывают справа внизу поверх всего -->
        <StackPanel x:Name="ToastHost"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"/>
    </Grid>
</Window>
